# ---- Domains (point DNS A records at the VPS first) ----
INBOX_DOMAIN=inbox.example.in
API_DOMAIN=api.example.in
# Only if you self-host the admin (docker compose --profile admin up -d); otherwise use Vercel
ADMIN_DOMAIN=admin.example.in
ACME_EMAIL=you@example.in

# ---- Secrets: generate each with `openssl rand -hex 32` ----
POSTGRES_PASSWORD=
REDIS_PASSWORD=
WAM_DB_PASSWORD=
WAM_SECRET_KEY=
WAM_WEBHOOK_SECRET=
# Chatwoot's Rails secret: `openssl rand -hex 64`
SECRET_KEY_BASE=

# ---- Chatwoot ----
DEFAULT_LOCALE=en
# Outgoing email for Chatwoot (password resets, notifications) — optional
MAILER_SENDER_EMAIL=WAM <no-reply@example.in>
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=true

# ---- WAM ↔ Chatwoot (fill after Chatwoot setup; can also be set per clinic in WAM admin) ----
CHATWOOT_API_TOKEN=
CHATWOOT_BOT_TOKEN=
CHATWOOT_TEMPLATE_FORMAT=enhanced

# ---- AI (optional; without it WAM runs on rules) ----
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5

# ---- First WAM admin login (created on first start) ----
BOOTSTRAP_ADMIN_EMAIL=you@example.in
BOOTSTRAP_ADMIN_PASSWORD=

# ---- Ops ----
ENABLE_SIMULATOR=true
# Slack/Discord/ntfy-compatible webhook for alerts (monitor.sh and WAM core)
ALERT_WEBHOOK_URL=
# Off-site backups: an rclone remote, e.g. "b2:wam-backups" (configure with `rclone config`)
BACKUP_REMOTE=
BACKUP_KEEP_DAYS=30
