# WAM core configuration (see wam/config.py for all options)
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://wam:wam@localhost:5432/wam
REDIS_URL=redis://localhost:6379/0
# 32+ random characters, e.g. `openssl rand -hex 32`
SECRET_KEY=change-me-in-production
# Part of the Chatwoot agent-bot URL: https://<core-host>/webhooks/chatwoot/<WEBHOOK_SECRET>
WEBHOOK_SECRET=change-me-webhook-secret

# Chatwoot (leave CHATWOOT_BASE_URL empty for dry-run: messages are only logged)
CHATWOOT_BASE_URL=
CHATWOOT_API_TOKEN=
CHATWOOT_BOT_TOKEN=
CHATWOOT_TEMPLATE_FORMAT=enhanced

# AI (leave empty to run on rules only)
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5

ENABLE_SIMULATOR=true
PROCESS_INLINE=false
ALERT_WEBHOOK_URL=
# Created by `python -m wam.cli bootstrap` if set
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
